{
  "name": "trading-system-ui",
  "version": "0.1.0",
  "description": "Browser dashboard for the trading runner — gRPC-Web client replacing the Rust TUI",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/free-port.mjs 5173",
    "dev": "vite",
    "start": "npm run build && vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "prepreview": "node scripts/free-port.mjs 4173",
    "build": "npm run generate && tsc -b && vite build",
    "generate": "buf generate",
    "proxy:up": "docker-compose -f docker/docker-compose.yml up -d --remove-orphans grpc-web-proxy",
    "proxy:down": "docker-compose -f docker/docker-compose.yml stop grpc-web-proxy",
    "mongo:up": "docker-compose -f docker/docker-compose.yml --profile auth up -d mongo",
    "stack:up": "docker-compose -f docker/docker-compose.yml --profile auth up -d --remove-orphans",
    "stack:down": "docker-compose -f docker/docker-compose.yml --profile auth down --remove-orphans",
    "preserver": "node scripts/free-port.mjs 3001",
    "server": "tsx server/index.ts",
    "predev:all": "node scripts/free-port.mjs 5173 && node scripts/free-port.mjs 3001",
    "dev:all": "npm run predev:all && concurrently -n ui,auth -c cyan,magenta \"npm run dev\" \"npm run server\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@connectrpc/connect": "^1.6.1",
    "@connectrpc/connect-web": "^1.6.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@tanstack/react-query": "^5.66.9",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "class-variance-authority": "^0.7.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "mongodb": "^6.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.50.0",
    "@eslint/js": "^9.19.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "happy-dom": "^20.10.6",
    "postcss": "^8.5.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "tsx": "^4.19.2",
    "vite": "^5.4.14",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
