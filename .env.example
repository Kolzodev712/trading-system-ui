# gRPC-Web proxy URL (browser-facing). In dev, Vite proxies /grpc to this.
VITE_GRPC_WEB_URL=/grpc

# Optional: override Vite proxy target (default http://localhost:8081)
# GRPC_WEB_PROXY=http://127.0.0.1:8081

# Auth API (Express). Vite proxies /api → this in dev.
AUTH_PORT=3001
# AUTH_API_PROXY=http://127.0.0.1:3001

# MongoDB for UI credentials (credentials collection)
MONGODB_URI=mongodb://127.0.0.1:27017/trading_ui

# Docker Mongo host port (only when using npm run mongo:up / stack:up)
# Published on loopback only — see docker/docker-compose.yml
# MONGO_HOST_PORT=27018

# Authentication mode for the Express login API (browser session JWT).
#   lab    — local demonstrations only: may seed admin/admin and allow JWT_SECRET demo default
#   secure — no auto-seed; JWT_SECRET must be a strong non-default value (fail closed otherwise)
# When unset: lab if NODE_ENV is not "production"; otherwise secure.
# Non-lab deployments without secure settings are unsupported — see docs/deployment.md.
AUTH_MODE=lab

# Deprecated aliases (use AUTH_MODE instead):
# LAB_MODE=1
# AUTH_ALLOW_DEV_DEFAULTS=1

# Demonstration-only when AUTH_MODE=lab. Required (non-default) when AUTH_MODE=secure.
JWT_SECRET=dev-only-change-in-production

# Optional: mount a runner operator token for Envoy → runner gRPC (see docker/envoy.yaml).
# TRADING_OPERATOR_TOKEN_FILE=./operator_token.empty